+                    <span class="block truncate text-[13px] text-fg">
+                      {{ file.file }}
+                    </span>
+                    <span class="block truncate text-xs text-muted">
+                      {{ file.title }}
+                      <template v-if="file.track_number">
+                        · #{{ file.track_number }}
+                      </template>
+                      · {{ formatBytes(file.size) }}
+                    </span>
+                  </span>
