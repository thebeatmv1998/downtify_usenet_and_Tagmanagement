+<template>
+  <div
+    class="mx-auto flex max-w-[1680px] flex-col gap-8 px-4 pt-6 sm:px-6 md:pt-8 lg:px-10"
+  >
+    <PageHeader :title="t('similar.title')" :subtitle="t('similar.subtitle')" />
