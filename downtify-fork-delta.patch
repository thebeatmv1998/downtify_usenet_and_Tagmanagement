+  <Config Name="WebUI Port" Target="8000" Default="30321" Mode="tcp" Description="Container Port: 8000 (DOWNTIFY_PORT). Map any free host port." Type="Port" Display="always" Required="true" Mask="false">8000</Config>
+  <Config Name="Downloads" Target="/downloads" Default="/mnt/user/downloads/music/downtify" Mode="rw" Description="Downloaded music library." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/downloads/music/downtify</Config>
